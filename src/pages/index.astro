        </div>
      </section>
    </div>

    <!-- Galería dinámica (Nuestros trabajos) -->
    <section id="catalogo" class="relative py-24 reveal scroll-mt-24 mb-16">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col items-center text-center mb-12 px-6">
          <span class="text-brand text-sm font-display font-semibold uppercase tracking-widest mb-3">
            Nuestros trabajos
          </span>
          <h2 class="font-display text-3xl md:text-5xl font-bold text-light text-balance">
            Proyectos recientes
          </h2>
          <p class="text-muted text-base max-w-2xl mt-4 text-balance">
            Conocé algunos de nuestros bordados y estampados realizados para marcas como la tuya.
          </p>
        </div>

        <!-- Mobile: scroll horizontal | Desktop: grid -->
        <div class="flex md:grid md:grid-cols-3 gap-4 overflow-x-auto md:overflow-visible snap-x snap-mandatory px-6 pb-4 md:px-0 md:pb-0 scrollbar-hide">
          
          <div class="relative min-w-[70vw] md:min-w-0 h-72 md:h-80 group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 snap-center">
            <img src="galeria1.jpg" alt="Trabajo de bordado" class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110" loading="lazy" />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent"></div>
            <span class="absolute bottom-4 left-4 text-xs bg-brand/20 text-brand px-3 py-1.5 rounded-full font-medium backdrop-blur-sm">Bordado</span>
          </div>

          <div class="relative min-w-[70vw] md:min-w-0 h-72 md:h-80 group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 snap-center">
            <img src="galeria2.jpg" alt="Estampado DTF personalizado" class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110" loading="lazy" />
