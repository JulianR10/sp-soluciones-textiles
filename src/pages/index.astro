      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
          <div class="text-center p-6 rounded-2xl bg-white/5 backdrop-blur-md border border-white/10">
            <p class="font-display text-3xl md:text-4xl font-bold text-brand mb-1">500+</p>
