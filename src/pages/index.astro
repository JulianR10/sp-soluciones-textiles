---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import bgmain from '../assets/bgmainblur.webp';
import bgPrendasPersonalizadas from '../assets/bgPrendasPersonalizadas.webp';
import bgPrendasLisas from '../assets/bgPrendasLisas.webp';
import bgelaboracion from '../assets/bgelaboracion.webp';
import nosotros from '../assets/nosotros.webp';
import boton from '../assets/boton.webp';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import InstagramIcon from '../components/icons/InstagramIcon.astro';
import FacebookIcon from '../components/icons/FacebookIcon.astro';
---

<Layout title="Inicio">
  <div class="relative overflow-hidden bg-dark">

    <!-- Fondo Global Continuo -->
    
    <!-- Glow superior -->
    <div class="absolute -top-50 -left-37.5 w-175 h-175 rounded-full bg-brand/10 blur-[180px] pointer-events-none"></div>

    <!-- Glow centro -->
    <div class="absolute top-[35%] -right-62.5 w-200 h-200 rounded-full bg-brand/5 blur-[200px] pointer-events-none"></div>

    <!-- Glow inferior -->
    <div class="absolute -bottom-62.5 left-1/2 -translate-x-1/2 w-225 h-225 rounded-full bg-brand/10 blur-[220px] pointer-events-none"></div>

    <!-- Hero -->
    <section 
      class="relative min-h-[100svh] pt-20 flex flex-col items-center justify-center text-center px-6 overflow-hidden"
    >
      <div
        class="absolute inset-0 scale-105 bg-cover bg-center bg-no-repeat"
        style={`background-image: url('${bgmain.src}');`}
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-0 bg-linear-to-b from-dark/10 to-dark"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 px-10 sm:px-14 md:px-16 py-7 sm:py-10 md:py-16 flex flex-col items-center text-center max-w-6xl mx-auto w-full">

        <!-- Esquinas -->
        <span class="absolute top-0 left-0 w-6 h-px bg-brand"></span>
        <span class="absolute top-0 left-0 w-px h-6 bg-brand"></span>

        <span class="absolute top-0 right-0 w-6 h-px bg-brand"></span>
        <span class="absolute top-0 right-0 w-px h-6 bg-brand"></span>

        <span class="absolute bottom-0 left-0 w-6 h-px bg-brand"></span>
        <span class="absolute bottom-0 left-0 w-px h-6 bg-brand"></span>

        <span class="absolute bottom-0 right-0 w-6 h-px bg-brand"></span>
        <span class="absolute bottom-0 right-0 w-px h-6 bg-brand"></span>

        <!-- Título -->
        <h1 class="relative font-display text-4xl sm:text-5xl md:text-8xl font-bold tracking-tight leading-tight mb-6 text-balance">
          <span class="text-shimmer">Personalizamos</span><br />
          <span class="text-shimmer">cada detalle</span><br />
          <span class="text-shimmer">de tu marca.</span>
        </h1>

        <p class="relative text-muted text-base md:text-lg max-w-xl mt-4 text-balance">
          Bordados y estampados DTF con calidad premium. Desde el diseño hasta la producción final.
        </p>

        <a href="https://wa.me/5491112345678"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contactanos por WhatsApp"
          class="relative inline-flex items-center justify-center gap-2 mt-8 whitespace-nowrap px-4 py-2 sm:px-6 bg-brand text-dark font-display font-semibold text-sm sm:text-base rounded-xl hover:opacity-90 active:scale-95 transition-all duration-200">
          
          <WhatsAppIcon size={22} />

          Consultanos por WhatsApp
        </a>

      </div>
    </section>


    <!-- Servicios -->
    <section id="servicios" class="relative py-24 px-6 reveal scroll-mt-24">
      <div class="max-w-6xl mx-auto">

        <!-- Header -->
        <div class="flex flex-col items-center text-center mb-16">
          <span class="text-brand text-sm font-display font-semibold uppercase tracking-widest mb-3">
            Lo que ofrecemos
          </span>

          <h2 class="font-display text-3xl md:text-6xl font-bold text-light mb-6 text-balance">
            Nuestros Servicios
          </h2>
        </div>

        <!-- Cards -->
        <div class="relative grid grid-cols-1 md:grid-cols-2 gap-10">

  <!-- Card: Producto Personalizado -->
  <div class="group relative p-8 sm:p-12 md:pb-28 rounded-3xl bg-white/3 backdrop-blur-md min-h-[60vh] md:min-h-[75vh] flex flex-col justify-end overflow-hidden">

    <!-- Costura overlock exterior (línea continua) -->
    <div class="absolute inset-[2px] rounded-[22px] pointer-events-none z-10 border border-brand/30"></div>

    <!-- Puntada de seguridad paralela (línea de puntos) -->
    <div class="absolute inset-[7px] rounded-[17px] pointer-events-none z-10 border border-dashed border-brand/20"></div>

    <!-- Contenedor para imagen de fondo -->
    <div class="absolute inset-0 rounded-3xl overflow-hidden z-0">
      <div class="absolute inset-0 scale-105 bg-cover bg-center bg-no-repeat blur-[1px] transition-transform duration-700 group-hover:scale-110" style={`background-image: url('${bgPrendasPersonalizadas.src}');`}></div>
      <div class="absolute inset-0 bg-dark/90 opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 max-md:opacity-100"></div>
      <div class="absolute bottom-0 left-0 right-0 h-[35%] bg-linear-to-t from-dark to-transparent"></div>
    </div>

    <div class="relative z-10 flex w-full flex-col max-md:flex-col">
      <!-- Contenido oculto que aparece en hover -->
      <div class="transition-all duration-500 ease-out max-md:max-h-[500px] max-md:opacity-100 max-md:translate-y-0 max-md:order-1 max-h-0 opacity-0 translate-y-4 md:group-hover:max-h-96 md:group-hover:opacity-100 md:group-hover:translate-y-0 overflow-hidden">
        <div class="pb-6 max-md:flex max-md:flex-col">
          <div class="space-y-4 max-md:order-1">
            <p class="text-muted text-base leading-relaxed text-balance max-md:text-light max-md:text-sm group-hover:text-light">
              Llevamos tu marca a cada prenda. Diseñamos y producimos piezas únicas con tu identidad.
            </p>
            <p class="text-muted text-base leading-relaxed text-balance max-md:text-light max-md:text-sm group-hover:text-light">Trabajamos con empresas y emprendedores para desarrollar colecciones exclusivas. Desde la elección de telas hasta el bordado o estampado final, cada detalle cuenta.</p>
          </div>
          <div class="flex flex-wrap gap-3 mt-6 max-md:order-2">
            <span class="text-xs bg-brand/20 text-brand px-3 py-1.5 rounded-full max-md:text-[10px] font-medium">Asesoramiento personalizado sin costo</span>
            <span class="text-xs bg-brand/20 text-brand px-3 py-1.5 rounded-full max-md:text-[10px] font-medium">Muestras físicas previas</span>
            <span class="text-xs bg-brand/20 text-brand px-3 py-1.5 rounded-full max-md:text-[10px] font-medium">Escalabilidad de volúmenes</span>
            <span class="text-xs bg-brand/20 text-brand px-3 py-1.5 rounded-full max-md:text-[10px] font-medium">Plazos ajustados</span>
          </div>
        </div>
      </div>

      <!-- Título - mobile: primero -->
      <div class="max-md:order-0 md:mt-auto flex-shrink-0">
        <div class="mb-6">
          <h3 class="font-display text-2xl md:text-4xl font-bold text-light group-hover:text-brand transition-colors text-balance">
            Prendas Personalizadas
          </h3>
        </div>
      </div>
    </div>

  </div>

  <!-- Card: Prendas Lisas -->
  <div class="group relative p-8 sm:p-12 md:pb-28 rounded-3xl bg-white/3 backdrop-blur-md min-h-[60vh] md:min-h-[75vh] flex flex-col justify-end overflow-hidden">

    <!-- Costura overlock exterior (línea continua) -->
    <div class="absolute inset-[2px] rounded-[22px] pointer-events-none z-10 border border-brand/30"></div>

    <!-- Puntada de seguridad paralela (línea de puntos) -->
    <div class="absolute inset-[7px] rounded-[17px] pointer-events-none z-10 border border-dashed border-brand/20"></div>

    <!-- Contenedor para imagen de fondo -->
    <div class="absolute inset-0 rounded-3xl overflow-hidden z-0">
      <div class="absolute inset-0 scale-105 bg-cover bg-center bg-no-repeat blur-[1px] transition-transform duration-700 group-hover:scale-110" style={`background-image: url('${bgPrendasLisas.src}');`}></div>
      <div class="absolute inset-0 bg-dark/90 opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 max-md:opacity-100"></div>
      <div class="absolute bottom-0 left-0 right-0 h-[35%] bg-linear-to-t from-dark to-transparent"></div>
    </div>

    <div class="relative z-10 flex w-full flex-col max-md:flex-col">
      <!-- Contenido oculto que aparece en hover -->
      <div class="transition-all duration-500 ease-out max-md:max-h-[500px] max-md:opacity-100 max-md:translate-y-0 max-md:order-1 max-h-0 opacity-0 translate-y-4 md:group-hover:max-h-96 md:group-hover:opacity-100 md:group-hover:translate-y-0 overflow-hidden">
        <div class="pb-6 max-md:flex max-md:flex-col">
          <div class="space-y-4 max-md:order-1">
            <p class="text-muted text-base leading-relaxed text-balance max-md:text-light max-md:text-sm group-hover:text-light">
              Calidad de base para armar tu marca con distintos modelos y colores.
            </p>
            <p class="text-muted text-base leading-relaxed text-balance max-md:text-light max-md:text-sm group-hover:text-light">Contamos con un amplio stock de prendas lisas de primeras marcas: remeras, buzos, camperas, gorras y m&aacute;s. Todo listo para personalizar con bordado o DTF.</p>
          </div>
          <div class="flex flex-wrap gap-3 mt-6 max-md:order-2">
            <span class="text-xs bg-brand/20 text-brand px-3 py-1.5 rounded-full max-md:text-[10px] font-medium">Algod&oacute;n peinado 24/1 y 30/1</span>
            <span class="text-xs bg-brand/20 text-brand px-3 py-1.5 rounded-full max-md:text-[10px] font-medium">Amplia paleta de colores</span>
            <span class="text-xs bg-brand/20 text-brand px-3 py-1.5 rounded-full max-md:text-[10px] font-medium">Tallas XS a 4XL</span>
            <span class="text-xs bg-brand/20 text-brand px-3 py-1.5 rounded-full max-md:text-[10px] font-medium">Certificados de calidad</span>
          </div>
        </div>
      </div>

      <!-- Título - mobile: primero -->
      <div class="max-md:order-0 md:mt-auto flex-shrink-0">
        <div class="mb-6">
          <h3 class="font-display text-2xl md:text-4xl font-bold text-light group-hover:text-brand transition-colors text-balance">
            Prendas Lisas
          </h3>
        </div>
      </div>
    </div>
  </div>
</div>

      </div>
    </section>

    <!-- Ticker Servicios -->
    <div class="relative">
      <div class="absolute inset-0 bg-linear-to-r from-brand/8 via-transparent to-brand/8" aria-hidden="true"></div>
      <section class="ticker-bg relative py-6 overflow-hidden">
        <div class="ticker-track">
          <div class="ticker-row">
            <span>bordados</span>
            <span class="sep">✦</span>
            <span>DTF</span>
            <span class="sep">✦</span>
            <span>prendas lisas</span>
            <span class="sep">✦</span>
            <span>prendas personalizadas</span>
            <span class="sep">✦</span>
            <span>uniformes corporativos</span>
            <span class="sep">✦</span>
            <span>indumentaria para marcas</span>
            <span class="sep">✦</span>
            <span>gorras personalizadas</span>
            <span class="sep">✦</span>
            <span>buzos personalizados</span>
            <span class="sep">✦</span>
            <span>remeras estampadas</span>
            <span class="sep">✦</span>
            <span>asesoramiento textil</span>
            <span class="sep">✦</span>
          </div>
          <div class="ticker-row" aria-hidden="true">
            <span>bordados</span>
            <span class="sep">✦</span>
            <span>DTF</span>
            <span class="sep">✦</span>
            <span>prendas lisas</span>
            <span class="sep">✦</span>
            <span>prendas personalizadas</span>
            <span class="sep">✦</span>
            <span>uniformes corporativos</span>
            <span class="sep">✦</span>
            <span>indumentaria para marcas</span>
            <span class="sep">✦</span>
            <span>gorras personalizadas</span>
            <span class="sep">✦</span>
            <span>buzos personalizados</span>
            <span class="sep">✦</span>
            <span>remeras estampadas</span>
            <span class="sep">✦</span>
            <span>asesoramiento textil</span>
            <span class="sep">✦</span>
          </div>
        </div>
      </section>
    </div>

    <!-- Galería dinámica (Nuestros trabajos) -->
    <section id="catalogo" class="relative py-24 px-6 reveal scroll-mt-24 hidden">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col items-center text-center mb-12">
          <span class="text-brand text-sm font-display font-semibold uppercase tracking-widest mb-3">
            Nuestros trabajos
          </span>
          <h2 class="font-display text-3xl md:text-5xl font-bold text-light text-balance">
            Proyectos recientes
          </h2>
          <p class="text-muted text-base max-w-2xl mt-4 text-balance">
            Conocé algunos de nuestros bordados y estampados realizados para marcas como la tuya.
          </p>
        </div>

        <!-- Contenedor con flex y superposición -->
        <div class="flex flex-wrap justify-center md:flex-nowrap gap-4 md:gap-0">
          
           <!-- Imagen 1 -->
          <div class="relative w-64 h-64 md:w-[40vh] md:h-[40vh] lg:w-[50vh] lg:h-[50vh] group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 md:-ml-6 first:ml-0">
            <img 
              src="galeria1.jpg" 
              alt="Trabajo de bordado 1" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"></div>
          </div>

          <!-- Imagen 2 -->
          <div class="relative w-64 h-64 md:w-[40vh] md:h-[40vh] lg:w-[50vh] lg:h-[50vh] group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 md:-ml-6">
            <img 
              src="galeria2.jpg" 
              alt="Estampado DTF personalizado" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"></div>
          </div>

          <!-- Imagen 3 -->
          <div class="relative w-64 h-64 md:w-[40vh] md:h-[40vh] lg:w-[50vh] lg:h-[50vh] group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 md:-ml-6">
            <img 
              src="galeria3.jpg" 
              alt="Prenda lisa con bordado" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"></div>
          </div>

          <!-- Imagen 4 -->
          <div class="relative w-64 h-64 md:w-[40vh] md:h-[40vh] lg:w-[50vh] lg:h-[50vh] group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 md:-ml-6">
            <img 
              src="galeria4.jpg" 
              alt="Detalle de estampado DTF" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"></div>
          </div>

          <!-- Imagen 5 -->
          <div class="relative w-64 h-64 md:w-[40vh] md:h-[40vh] lg:w-[50vh] lg:h-[50vh] group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 md:-ml-6">
            <img 
              src="galeria5.jpg" 
              alt="Conjunto personalizado" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"></div>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative py-24 px-6 reveal overflow-hidden">
      <div
        class="absolute inset-0 scale-105 bg-cover bg-center bg-no-repeat blur-xs"
        style={`background-image: url('${bgelaboracion.src}');`}
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-0 bg-linear-to-b from-dark/70 via-dark/75 to-dark"
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-x-0 top-0 h-32 bg-linear-to-b from-dark to-transparent"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 flex flex-col items-center text-center">

        <span class="text-brand text-sm font-display font-semibold uppercase tracking-widest mb-3">
          ¿Qué estás necesitando?
        </span>

        <h2 class="font-display text-3xl md:text-6xl font-bold text-light max-w-3xl leading-[1.05] mb-6 text-balance">
          Contanos tu idea, consultá por nuestros servicios o pedinos una cotización
        </h2>

        <p class="text-muted text-base max-w-xl leading-relaxed mb-10 text-balance">
          Estamos para ayudarte a concretar tu proyecto.
        </p>

        <a href="https://wa.me/5491112345678"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contactanos por WhatsApp"
          class="group relative inline-flex max-w-full items-center justify-center gap-2 whitespace-nowrap px-4 py-2 sm:px-6 rounded-2xl bg-brand text-dark font-display font-semibold text-sm sm:text-base overflow-hidden transition-all duration-500 hover:scale-[1.02] active:scale-[0.98] shadow-[0_0_40px_rgba(255,140,0,0.15)]">

          <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>

          <WhatsAppIcon size={18} class="relative z-10" />

          <span class="relative z-10">
            Consultanos por WhatsApp
          </span>
        </a>

      </div>
    </section>

        <!-- Técnicas - Layout asimétrico, sin hover, párrafos siempre visibles -->
    <section class="relative w-[calc(100%-3rem)] md:w-[80vw] mx-auto py-24 px-5 sm:px-6 reveal rounded-3xl overflow-hidden bg-dark" style={`background-image: url('${import.meta.env.BASE_URL}weave-pattern.svg'); background-repeat: repeat;`}>

      <!-- Costura overlock exterior (línea continua) -->
      <div class="absolute inset-[2px] rounded-[22px] pointer-events-none z-10 border border-brand/50"></div>

      <!-- Puntada de seguridad paralela (línea de puntos) -->
      <div class="absolute inset-[7px] rounded-[17px] pointer-events-none z-10 border border-dashed border-brand/60"></div>

      <div class="relative z-20 max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        
        <!-- COLUMNA IZQUIERDA: texto introductorio -->
        <div class="text-center lg:text-left">
          <span class="text-brand text-sm font-display font-semibold uppercase tracking-widest mb-3 inline-block">
            Técnicas que utilizamos
          </span>
          <h2 class="font-display text-3xl md:text-5xl lg:text-6xl font-bold text-light leading-tight mb-6 text-balance">
            ¿Con qué <br class="hidden lg:block">trabajamos?
          </h2>
          <div class="w-12 h-px bg-brand mb-6 lg:mx-0 mx-auto"></div>
          <p class="text-muted text-base leading-relaxed text-balance max-md:hidden">
            Utilizamos dos técnicas de alta calidad para garantizar resultados profesionales, duraderos y con una terminación impecable.
          </p>
          <p class="text-muted text-base leading-relaxed mt-4 text-balance max-md:hidden">
            Elegí la que mejor se adapte a tu proyecto o combiná ambas para un resultado único.
          </p>
        </div>

        <!-- COLUMNA DERECHA: tarjetas con título y párrafo visibles -->
        <div class="flex flex-col gap-16 text-center lg:text-left">
          
          <div>
            <div class="flex items-center justify-center lg:justify-start gap-3 mb-2">
              <Image src={boton} alt="" width={28} height={28} class="flex-shrink-0" />
              <h3 class="font-display text-2xl md:text-3xl font-bold text-light text-balance">
                Bordados
              </h3>
            </div>
            <p class="text-muted text-base leading-relaxed text-balance">
              Puntadas de alta precisión con relieve premium. Ideal para uniformes corporativos, marcas y prendas que buscan una terminación elegante y duradera.
            </p>
            <div class="mt-3 flex flex-wrap justify-center lg:justify-start gap-2">
              <span class="text-xs bg-brand/20 text-brand px-2 py-1 rounded-full">Alta durabilidad</span>
              <span class="text-xs bg-brand/20 text-brand px-2 py-1 rounded-full">Efecto 3D</span>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-center lg:justify-start gap-3 mb-2">
              <Image src={boton} alt="" width={28} height={28} class="flex-shrink-0" />
              <h3 class="font-display text-2xl md:text-3xl font-bold text-light text-balance">
                Estampado DTF
              </h3>
            </div>
            <p class="text-muted text-base leading-relaxed text-balance">
              Impresión digital de alta definición con colores vibrantes y excelente durabilidad sobre distintos tipos de telas.
            </p>
            <div class="mt-3 flex flex-wrap justify-center lg:justify-start gap-2">
              <span class="text-xs bg-brand/20 text-brand px-2 py-1 rounded-full">Alta resolución</span>
              <span class="text-xs bg-brand/20 text-brand px-2 py-1 rounded-full">Funciona en oscuras</span>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Nosotros -->
    <section id="nosotros" class="relative py-24 px-6 reveal scroll-mt-24">
      
      <div class="relative max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Imagen -->
        <div class="relative group">

          <div class="absolute inset-0 bg-brand/10 blur-3xl opacity-40 group-hover:opacity-60 transition-all duration-500"></div>

          <div class="relative overflow-hidden rounded-3xl border border-white/10">
            <img
