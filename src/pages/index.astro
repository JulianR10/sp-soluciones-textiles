---
import Layout from '../layouts/Layout.astro';
import bgmain from '../assets/bgmain.webp';
import bgPrendasPersonalizadas from '../assets/bgPrendasPersonalizadas.webp';
import bgPrendasLisas from '../assets/bgPrendasLisas.webp';
import bgelaboracion from '../assets/bgelaboracion.webp';
import nosotros from '../assets/nosotros.webp';
---

<Layout title="Inicio">
  <main class="relative overflow-hidden bg-dark reveal">

    <!-- Fondo Global Continuo -->
    
    <!-- Glow superior -->
    <div class="absolute -top-50 -left-37.5 w-175 h-175 rounded-full bg-brand/10 blur-[180px] pointer-events-none"></div>

    <!-- Glow centro -->
    <div class="absolute top-[35%] -right-62.5 w-200 h-200 rounded-full bg-brand/5 blur-[200px] pointer-events-none"></div>

    <!-- Glow inferior -->
    <div class="absolute -bottom-62.5 left-1/2 -translate-x-1/2 w-225 h-225 rounded-full bg-brand/10 blur-[220px] pointer-events-none"></div>

    <!-- Hero -->
    <section 
      class="relative min-h-[100dvh] pt-20 flex flex-col items-center justify-center text-center px-6 overflow-hidden"
    >
      <div
        class="absolute inset-0 scale-105 bg-cover bg-center bg-no-repeat blur-sm"
        style={`background-image: url('${bgmain.src}');`}
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-0 bg-linear-to-b from-dark/10 to-dark"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 p-6 sm:p-10 md:p-16 flex flex-col items-center text-center">

        <!-- Caja suave -->
        <div class="absolute inset-0 rounded-sm bg-white/2 backdrop-blur-[2px]"></div>

        <!-- Esquinas -->
        <span class="absolute top-0 left-0 w-6 h-px bg-brand"></span>
        <span class="absolute top-0 left-0 w-px h-6 bg-brand"></span>

        <span class="absolute top-0 right-0 w-6 h-px bg-brand"></span>
        <span class="absolute top-0 right-0 w-px h-6 bg-brand"></span>

        <span class="absolute bottom-0 left-0 w-6 h-px bg-brand"></span>
        <span class="absolute bottom-0 left-0 w-px h-6 bg-brand"></span>

        <span class="absolute bottom-0 right-0 w-6 h-px bg-brand"></span>
        <span class="absolute bottom-0 right-0 w-px h-6 bg-brand"></span>

        <!-- Título -->
        <h1 class="relative font-display text-5xl sm:text-6xl md:text-8xl font-bold tracking-tight leading-tight mb-6">
          <span class="text-shimmer">Personalizamos</span><br />
          <span class="text-shimmer">cada detalle</span><br />
          <span class="text-shimmer">de tu marca.</span>
        </h1>

        <p class="relative text-muted text-lg md:text-xl max-w-xl mt-4">
          Bordados y estampados DTF con calidad premium. Desde el diseño hasta la producción final.
        </p>

        <a href="https://wa.me/5491112345678"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contactanos por WhatsApp"
          class="relative inline-flex items-center justify-center gap-3 mt-8 max-w-full px-5 py-4 sm:px-8 bg-brand text-dark font-display font-semibold text-base sm:text-lg rounded-xl hover:opacity-90 active:scale-95 transition-all duration-200">
          
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
          </svg>

          Consultanos por WhatsApp
        </a>

      </div>
    </section>


    <!-- Servicios -->
    <section id="servicios" class="relative py-24 px-6 reveal scroll-mt-24">
      <div class="max-w-6xl mx-auto">

        <!-- Header -->
        <div class="flex flex-col items-center text-center mb-16">
          <span class="text-brand text-xs font-display font-semibold uppercase tracking-widest mb-3">
            Lo que ofrecemos
          </span>

          <h2 class="font-display text-4xl md:text-6xl font-bold text-light mb-6">
            Nuestros Servicios
          </h2>
        </div>

        <!-- Cards -->
        <div class="relative grid grid-cols-1 md:grid-cols-2 gap-10 mb-20">

  <!-- Card: Producto Personalizado -->
  <div class="group relative p-7 sm:p-10 md:pb-28 rounded-3xl border border-white/10 hover:border-brand/40 transition-all duration-500 bg-white/3 backdrop-blur-md min-h-[60vh] md:min-h-[75vh] flex items-center">

    <!-- Contenedor para imagen de fondo (futuro) -->
    <div class="absolute inset-0 rounded-3xl overflow-hidden z-0">
      <div class="absolute inset-0 scale-105 bg-cover bg-center bg-no-repeat blur-[1px] transition-transform duration-700 group-hover:scale-110" style={`background-image: url('${bgPrendasPersonalizadas.src}');`}></div>
      <div class="absolute inset-0 bg-dark/30 transition-opacity duration-500 group-hover:bg-dark/72"></div>
      <div class="absolute inset-0 bg-linear-to-t from-dark via-dark/85 to-dark/60"></div>
    </div>

    <div class="absolute inset-0 rounded-3xl bg-linear-to-br from-brand/3 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0"></div>

    <div class="relative z-10 flex w-full flex-col justify-center">
      <div class="mb-6">
        <div class="inline-block p-4 rounded-2xl bg-brand/10 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand">
            <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
          </svg>
        </div>
        <h3 class="font-display text-3xl md:text-4xl font-bold text-light group-hover:text-brand transition-colors">
          Prendas Personalizadas
        </h3>
      </div>

      <p class="relative text-muted text-lg leading-relaxed mb-4">
        Llevamos tu marca a cada prenda. Diseñamos y producimos piezas únicas con tu identidad.
      </p>

      <!-- Texto adicional para dar altura -->
      <div class="mt-4 space-y-3 text-muted text-base">
        <p>Trabajamos con empresas y emprendedores para desarrollar colecciones exclusivas. Desde la elección de telas hasta el bordado o estampado final, cada detalle cuenta.</p>
        <ul class="list-disc list-inside space-y-1 text-muted">
          <li>Asesoramiento personalizado sin costo</li>
          <li>Muestras físicas previas a la producción</li>
          <li>Escalabilidad para pequeños y grandes volúmenes</li>
          <li>Plazos de entrega ajustados a tu necesidad</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Card: Prendas Lisas -->
  <div class="group relative p-7 sm:p-10 md:pb-28 rounded-3xl border border-white/10 hover:border-brand/40 transition-all duration-500 bg-white/3 backdrop-blur-md min-h-[60vh] md:min-h-[75vh] flex items-center">

    <!-- Contenedor para imagen de fondo -->
    <div class="absolute inset-0 rounded-3xl overflow-hidden z-0">
      <div class="absolute inset-0 scale-105 bg-cover bg-center bg-no-repeat blur-[1px] transition-transform duration-700 group-hover:scale-110" style={`background-image: url('${bgPrendasLisas.src}');`}></div>
      <div class="absolute inset-0 bg-dark/30 transition-opacity duration-500 group-hover:bg-dark/72"></div>
      <div class="absolute inset-0 bg-linear-to-t from-dark via-dark/85 to-dark/60"></div>
    </div>

    <div class="absolute inset-0 rounded-3xl bg-linear-to-br from-brand/3 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0"></div>

    <div class="relative z-10 flex w-full flex-col justify-center">
      <div class="mb-6">
        <div class="inline-block p-4 rounded-2xl bg-brand/10 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-brand">
            <rect width="18" height="18" x="3" y="3" rx="2"/>
          </svg>
        </div>
        <h3 class="font-display text-3xl md:text-4xl font-bold text-light group-hover:text-brand transition-colors">
          Prendas Lisas
        </h3>
      </div>

      <p class="relative text-muted text-lg leading-relaxed mb-4">
        Calidad de base para armar tu marca con distintos modelos y colores.
      </p>

      <!-- Texto adicional -->
      <div class="mt-4 space-y-3 text-muted text-base">
        <p>Contamos con un amplio stock de prendas lisas de primeras marcas: remeras, buzos, camperas, gorras y más. Todo listo para personalizar con bordado o DTF.</p>
        <ul class="list-disc list-inside space-y-1 text-muted">
          <li>Algodón peinado 24/1 y 30/1</li>
          <li>Amplia paleta de colores (blanco, negro, gris, colores fantasía)</li>
          <li>Tallas desde XS hasta 4XL</li>
          <li>Certificados de calidad y origen textil</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="relative z-20 flex justify-center md:absolute md:left-1/2 md:bottom-10 md:-translate-x-1/2">
    <div class="absolute inset-x-[-2rem] inset-y-[-1.25rem] rounded-full bg-dark/85 blur-2xl md:inset-x-[-3rem] md:inset-y-[-1.5rem]"></div>
    <a href="https://wa.me/5491112345678"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Consultar por WhatsApp"
      class="relative inline-flex max-w-full items-center justify-center gap-3 px-5 py-4 sm:px-8 bg-brand text-dark font-display font-semibold text-base sm:text-lg rounded-xl hover:opacity-90 active:scale-95 transition-all duration-200 shadow-[0_0_35px_rgba(255,144,37,0.22)]">
      
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
      </svg>

      Cotizar por WhatsApp
    </a>
  </div>
</div>

      </div>
    </section>

    <!-- Servicios Marquee -->
    <section class="relative py-8 overflow-hidden reveal">
      <div class="relative border-y border-white/10 bg-white/3 backdrop-blur-sm">
        <div class="services-marquee flex w-max py-5">
          <div class="services-marquee-track flex items-center">
            <span>Bordados</span>
            <span>DTF</span>
            <span>Prendas lisas</span>
            <span>Prendas personalizadas</span>
            <span>Uniformes corporativos</span>
            <span>Indumentaria para marcas</span>
            <span>Gorras personalizadas</span>
            <span>Buzos personalizados</span>
            <span>Remeras estampadas</span>
            <span>Asesoramiento textil</span>
          </div>

          <div class="services-marquee-track flex items-center" aria-hidden="true">
            <span>Bordados</span>
            <span>DTF</span>
            <span>Prendas lisas</span>
            <span>Prendas personalizadas</span>
            <span>Uniformes corporativos</span>
            <span>Indumentaria para marcas</span>
            <span>Gorras personalizadas</span>
            <span>Buzos personalizados</span>
            <span>Remeras estampadas</span>
            <span>Asesoramiento textil</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Galería dinámica (Nuestros trabajos) -->
        <!-- Galería dinámica (Nuestros trabajos) -->
    <section id="catalogo" class="relative py-24 px-6 reveal scroll-mt-24">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col items-center text-center mb-12">
          <span class="text-brand text-xs font-display font-semibold uppercase tracking-widest mb-3">
            Nuestros trabajos
          </span>
          <h2 class="font-display text-3xl md:text-5xl font-bold text-light">
            Proyectos recientes
          </h2>
          <p class="text-muted text-base max-w-2xl mt-4">
            Conocé algunos de nuestros bordados y estampados realizados para marcas como la tuya.
          </p>
        </div>

        <!-- Contenedor con flex y superposición -->
        <div class="flex flex-wrap justify-center md:flex-nowrap gap-4 md:gap-0">
          
           <!-- Imagen 1 -->
          <div class="relative w-64 h-64 md:w-[40vh] md:h-[40vh] lg:w-[50vh] lg:h-[50vh] group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 md:-ml-6 first:ml-0">
            <img 
              src="galeria1.jpg" 
              alt="Trabajo de bordado 1" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"></div>
          </div>

          <!-- Imagen 2 -->
          <div class="relative w-64 h-64 md:w-[40vh] md:h-[40vh] lg:w-[50vh] lg:h-[50vh] group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 md:-ml-6">
            <img 
              src="galeria2.jpg" 
              alt="Estampado DTF personalizado" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"></div>
          </div>

          <!-- Imagen 3 -->
          <div class="relative w-64 h-64 md:w-[40vh] md:h-[40vh] lg:w-[50vh] lg:h-[50vh] group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 md:-ml-6">
            <img 
              src="galeria3.jpg" 
              alt="Prenda lisa con bordado" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"></div>
          </div>

          <!-- Imagen 4 -->
          <div class="relative w-64 h-64 md:w-[40vh] md:h-[40vh] lg:w-[50vh] lg:h-[50vh] group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 md:-ml-6">
            <img 
              src="galeria4.jpg" 
              alt="Detalle de estampado DTF" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"></div>
          </div>

          <!-- Imagen 5 -->
          <div class="relative w-64 h-64 md:w-[40vh] md:h-[40vh] lg:w-[50vh] lg:h-[50vh] group/img overflow-hidden rounded-2xl border border-white/10 bg-dark/40 backdrop-blur-sm transition-all duration-300 hover:z-20 hover:scale-105 hover:shadow-[0_0_40px_rgba(255,144,37,0.4)] hover:border-brand/40 md:-ml-6">
            <img 
              src="galeria5.jpg" 
              alt="Conjunto personalizado" 
              class="w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-linear-to-t from-dark/80 via-dark/20 to-transparent opacity-0 group-hover/img:opacity-100 transition-opacity duration-300"></div>
          </div>

        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="relative py-24 px-6 reveal overflow-hidden">
      <div
        class="absolute inset-0 scale-105 bg-cover bg-center bg-no-repeat blur-xs"
        style={`background-image: url('${bgelaboracion.src}');`}
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-0 bg-linear-to-b from-dark/70 via-dark/75 to-dark"
        aria-hidden="true"
      ></div>
      <div
        class="absolute inset-x-0 top-0 h-32 bg-linear-to-b from-dark to-transparent"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 flex flex-col items-center text-center">

        <span class="text-brand text-xs font-display font-semibold uppercase tracking-widest mb-3">
          ¿Qué estás necesitando?
        </span>

        <h2 class="font-display text-4xl md:text-6xl font-bold text-light max-w-3xl leading-[1.05] mb-6">
          Contanos tu idea, consultá por nuestros servicios o pedinos una cotización
        </h2>

        <p class="text-muted text-lg max-w-xl leading-relaxed mb-10">
          Estamos para ayudarte a concretar tu proyecto.
        </p>

        <a href="https://wa.me/5491112345678"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Contactanos por WhatsApp"
          class="group relative inline-flex max-w-full items-center justify-center gap-3 px-6 py-5 sm:px-10 rounded-2xl bg-brand text-dark font-display font-semibold text-base sm:text-lg overflow-hidden transition-all duration-500 hover:scale-[1.02] active:scale-[0.98] shadow-[0_0_40px_rgba(255,140,0,0.15)]">

          <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>

          <svg xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="currentColor"
            class="relative z-10">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884"/>
          </svg>

          <span class="relative z-10">
            Consultanos por WhatsApp
          </span>
        </a>

      </div>
    </section>

        <!-- Técnicas - Layout asimétrico, sin hover, párrafos siempre visibles -->
    <section class="relative w-[calc(100%-3rem)] md:w-[80vw] mx-auto py-20 md:py-24 px-5 sm:px-6 reveal bg-brand/5 rounded-3xl overflow-hidden">
      <div class="absolute inset-0 rounded-3xl border border-brand/15 shadow-[0_0_32px_rgba(255,144,37,0.09),inset_0_0_24px_rgba(255,144,37,0.04)] pointer-events-none"></div>
      <div class="absolute inset-px rounded-3xl bg-linear-to-br from-white/5 via-transparent to-brand/5 pointer-events-none"></div>

      <div class="relative z-10 max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        
        <!-- COLUMNA IZQUIERDA: texto introductorio -->
        <div class="text-center lg:text-left">
          <span class="text-brand text-xs font-display font-semibold uppercase tracking-widest mb-3 inline-block">
            Técnicas que utilizamos
            Técnicas utilizadas
          </span>
          <h2 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-light leading-tight mb-6">
            ¿Con qué <br class="hidden lg:block">trabajamos?
          </h2>
          <div class="w-12 h-px bg-brand mb-6 lg:mx-0 mx-auto"></div>
          <p class="text-muted text-base md:text-lg leading-relaxed">
            Utilizamos dos técnicas de alta calidad para garantizar resultados profesionales, duraderos y con una terminación impecable.
          </p>
          <p class="text-muted text-base md:text-lg leading-relaxed mt-4">
            Elegí la que mejor se adapte a tu proyecto o combiná ambas para un resultado único.
          </p>
        </div>

        <!-- COLUMNA DERECHA: tarjetas con título y párrafo visibles -->
        <div class="flex flex-col gap-6">
          
          <!-- Tarjeta Bordados -->
          <div class="relative min-h-52 p-6 rounded-2xl border border-white/10 bg-white/3 backdrop-blur-md transition-all duration-300 flex flex-col justify-center">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-3 h-3 rounded-full bg-brand"></div>
              <h3 class="font-display text-2xl md:text-3xl font-bold text-light">
                Bordados
              </h3>
