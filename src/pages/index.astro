          </a>
          <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-white/15 text-light font-display font-semibold text-sm hover:border-brand/40 hover:text-brand hover:scale-105 transition-all duration-300">
            <FacebookIcon size={16} />
