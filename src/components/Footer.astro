---
import logo from '../assets/logo.png';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import FacebookIcon from './icons/FacebookIcon.astro';
---

<footer class="relative w-full bg-dark border-t border-white/10">
  <div class="max-w-6xl mx-auto px-6 py-10">
    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr_1fr] gap-8 place-items-center md:place-items-start">

      <!-- Columna 1: Logo y descripción -->
      <div class="flex flex-col items-center md:items-start gap-4">
        <a href="/" class="flex items-center gap-3">
          <img src={logo.src} alt="SP Soluciones Textiles" width={40} height={40} />
          <span class="text-white font-display font-semibold text-base">SP Soluciones Textiles</span>
        </a>
        <p class="text-muted text-sm leading-relaxed max-w-xs text-balance text-center md:text-left">
          Bordados y estampados DTF con calidad premium. Desde el diseño hasta la producción final.
        </p>
      </div>

      <!-- Columna 2: Navegación -->
      <div class="flex flex-col items-center md:items-start gap-4">
        <span class="text-light font-display font-semibold text-sm uppercase tracking-widest">Navegación</span>
        <nav class="flex flex-col items-center md:items-start gap-3">
          <a href="/" class="text-muted hover:text-brand transition-colors text-sm">Inicio</a>
          <a href="#servicios" class="text-muted hover:text-brand transition-colors text-sm">Servicios</a>
          <a href="#catalogo" class="text-muted hover:text-brand transition-colors text-sm">Catálogo</a>
          <a href="#nosotros" class="text-muted hover:text-brand transition-colors text-sm">Nosotros</a>
          <a href="#contacto" class="text-muted hover:text-brand transition-colors text-sm">Contacto</a>
        </nav>
      </div>

      <!-- Columna 3: Contacto y redes -->
      <div class="flex flex-col items-center md:items-start gap-4">
        <span class="text-light font-display font-semibold text-sm uppercase tracking-widest">Contacto</span>
        <div class="flex flex-col items-center md:items-start gap-3">
          <a href="https://wa.me/5491112345678" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center md:justify-start gap-2 text-muted hover:text-brand transition-colors text-sm">
            <WhatsAppIcon size={16} />
            WhatsApp
          </a>
          <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center md:justify-start gap-2 text-muted hover:text-brand transition-colors text-sm">
            <InstagramIcon size={16} />
            Instagram
          </a>
          <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center md:justify-start gap-2 text-muted hover:text-brand transition-colors text-sm">
            <FacebookIcon size={16} />
            Facebook
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Barra inferior -->
  <div class="border-t border-white/5">
    <div class="max-w-6xl mx-auto px-6 py-3 flex flex-col sm:flex-row items-center justify-between gap-2 text-center">
      <p class="text-muted text-xs">&copy; {new Date().getFullYear()} SP Soluciones Textiles. Todos los derechos reservados.</p>
      <p class="text-muted/50 text-xs">Bordados &amp; Estampados DTF</p>
    </div>
  </div>
</footer>
