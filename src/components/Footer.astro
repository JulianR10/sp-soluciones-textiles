---
import firma from '../assets/firma.png';
import logo from '../assets/logo.png';
import { CONTACT, WHATSAPP_URL } from '../config';
import FacebookIcon from './icons/FacebookIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
---

<footer class="relative w-full bg-dark border-t border-white/10">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12">

      <!-- Columna 1: Logo y descripción -->
      <div class="flex flex-col items-center gap-4">
        <a href={import.meta.env.BASE_URL} class="flex items-center gap-3">
          <img src={logo.src} alt="SP Soluciones Textiles" width={40} height={40} />
          <span class="text-white font-display font-semibold text-base">SP Soluciones Textiles</span>
        </a>
        <p class="text-muted text-sm leading-relaxed max-w-xs text-balance text-center">
          Bordados y estampados DTF con calidad premium. Desde el diseño hasta la producción final.
        </p>
      </div>

      <!-- Columna 2: Links rápidos -->
      <div class="flex flex-col items-center gap-4">
        <span class="text-light font-display font-semibold text-sm uppercase tracking-widest">Navegación</span>
        <div class="flex flex-col items-center gap-3">
          <a href={import.meta.env.BASE_URL} class="text-muted hover:text-brand transition-colors text-sm">Inicio</a>
          <a href="#servicios" class="text-muted hover:text-brand transition-colors text-sm">Servicios</a>
          <a href="#contacto" class="text-muted hover:text-brand transition-colors text-sm">Contacto</a>
        </div>
      </div>

      <!-- Columna 3: Contacto y redes -->
      <div class="flex flex-col items-center gap-4">
        <span class="text-light font-display font-semibold text-sm uppercase tracking-widest">Contacto</span>
        <div class="flex flex-col items-center gap-3">
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 text-muted hover:text-brand transition-colors text-sm">
            <WhatsAppIcon size={16} />
            WhatsApp
          </a>
          <a href={CONTACT.instagram} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 text-muted hover:text-brand transition-colors text-sm">
            <InstagramIcon size={16} />
            Instagram
          </a>
          <a href={CONTACT.facebook} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 text-muted hover:text-brand transition-colors text-sm">
            <FacebookIcon size={16} />
            Facebook
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Barra inferior -->
  <div class="border-t border-white/10">
    <div class="max-w-6xl mx-auto px-5 sm:px-6 py-4 md:py-3 flex flex-col sm:flex-row items-center justify-between gap-2 text-center">
      <p class="text-muted text-xs">&copy; {new Date().getFullYear()} SP Soluciones Textiles. Todos los derechos reservados.</p>
      <p class="text-xs"><span class="bg-brand text-dark px-2 py-0.5 rounded font-medium inline-flex items-center gap-1">Hecho por <img src={firma.src} alt="" class="inline-block h-[18px] w-auto" /></span></p>
    </div>
  </div>
</footer>
