---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className = '' } = Astro.props;
---

<div class={`flex flex-col items-center text-center mb-16 md:mb-20 ${className}`}>
  {eyebrow && (
    <span class="text-brand text-sm font-display font-semibold uppercase tracking-widest mb-3 inline-block">
      {eyebrow}
    </span>
  )}
  <h2 class="font-display text-3xl md:text-5xl font-bold text-light leading-tight text-balance">{title}</h2>
  {description && <p class="text-muted text-base md:text-lg max-w-2xl mt-5 text-balance">{description}</p>}
</div>