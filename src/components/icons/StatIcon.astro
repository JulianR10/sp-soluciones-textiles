---
interface Props {
  name: 'bag' | 'star' | 'calendar' | 'clock';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg class={`w-7 h-7 text-brand/40 mb-3 mx-auto ${className}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
  {name === 'bag' && (
    <>
      <path d="M6 4h4l1 2h2l1-2h4l2 4v12H4V8z" />
      <path d="M10 4c0 1.1.9 2 2 2s2-.9 2-2" />
    </>
  )}
  {name === 'star' && <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />}
  {name === 'calendar' && (
    <>
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
      <line x1="16" y1="2" x2="16" y2="6" />
      <line x1="8" y1="2" x2="8" y2="6" />
      <line x1="3" y1="10" x2="21" y2="10" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="10" />
      <polyline points="12 6 12 12 16 14" />
    </>
  )}
</svg>