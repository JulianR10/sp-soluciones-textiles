---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { CONTACT, WHATSAPP_URL } from '../config';
import FacebookIcon from './icons/FacebookIcon.astro';
import InstagramIcon from './icons/InstagramIcon.astro';
import WhatsAppIcon from './icons/WhatsAppIcon.astro';
---

<header class="fixed top-0 left-0 w-full z-50 backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-5 sm:px-6 h-20 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href={import.meta.env.BASE_URL} class="header-logo flex min-w-0 items-center gap-3">
      <Image src={logo} alt="SP Soluciones Textiles" width={40} />
      <span class="truncate text-white font-semibold text-sm sm:text-base tracking-tight">SP Soluciones Textiles</span>
    </a>

    <!-- Nav -->
    <nav class="hidden md:flex items-center gap-8">
      <a href={import.meta.env.BASE_URL} data-nav="inicio" class="nav-link text-gray-300 hover:text-white transition-colors text-sm font-medium">Inicio</a>
      <a href="#servicios" data-nav="servicios" class="nav-link text-gray-300 hover:text-white transition-colors text-sm font-medium">Servicios</a>
      <span class="relative group cursor-default">
        <span class="text-gray-600 cursor-not-allowed text-sm font-medium select-none">Catálogo</span>
        <span class="absolute -top-8 left-1/2 -translate-x-1/2 px-2 py-1 rounded text-xs text-white bg-brand whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none shadow-lg">
          Próximamente
        </span>
      </span>
      <a href="#contacto" class="bg-brand text-dark font-bold text-sm px-5 py-2.5 rounded-full hover:scale-105 transition-transform shadow-lg">
        Contacto
      </a>
    </nav>

    <button id="menu-btn" class="md:hidden z-50 flex h-11 w-11 cursor-pointer items-center justify-center rounded-xl border border-white/10 text-white transition-all duration-500 hover:border-brand/60">
      <span class="sr-only">Men&uacute;</span>
      <svg id="menu-icon" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16"></path>
        <path d="M4 12h16"></path>
        <path d="M4 17h16"></path>
      </svg>
      <svg id="close-icon" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M6 6l12 12"></path>
        <path d="M18 6l-12 12"></path>
      </svg>
    </button>
  </div>
  <div id="header-line" class="absolute bottom-0 left-0 h-px bg-brand w-0 transition-all duration-700 ease-in-out"></div>
</header>

<div id="menu-overlay" class="fixed inset-0 z-40 bg-dark/60 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-500"></div>

<nav id="mobile-menu" class="fixed top-0 right-0 z-50 h-full w-72 max-w-[85vw] flex flex-col items-center justify-between py-24 px-6 bg-dark/95 backdrop-blur-xl translate-x-full transition-transform duration-500 ease-in-out shadow-2xl shadow-brand/5">

  <button id="drawer-close" class="absolute top-6 right-6 w-8 h-8 flex items-center justify-center text-muted hover:text-brand rounded-full border border-white/10 hover:border-brand/30 transition-all">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M6 6l12 12"></path>
      <path d="M18 6l-12 12"></path>
    </svg>
  </button>

  <!-- Links -->
  <div class="flex flex-col items-center gap-8">
    <a href={import.meta.env.BASE_URL} class="text-2xl font-display font-bold text-gray-200 hover:text-brand transition-colors">Inicio</a>
    <a href="#servicios" class="text-2xl font-display font-bold text-gray-200 hover:text-brand transition-colors">Servicios</a>
    <span class="flex items-center gap-2 cursor-default">
      <span class="text-2xl font-display font-bold text-gray-600 cursor-not-allowed select-none">Catálogo</span>
      <span class="text-[10px] leading-none font-semibold text-brand bg-brand/15 px-1.5 py-1 rounded-sm select-none">
        Próximamente
      </span>
    </span>
    <a href="#contacto" class="text-2xl font-display font-bold text-gray-200 hover:text-brand transition-colors">Contacto</a>
  </div>

  <!-- Bottom: tagline, social, CTA -->
  <div class="flex flex-col items-center gap-6 w-full">
    <p class="text-xs text-muted/60 font-display text-center leading-relaxed">
      Personalizamos tu marca
    </p>
    <div class="flex items-center gap-5">
      <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-brand transition-colors" aria-label="WhatsApp">
        <WhatsAppIcon size={20} />
      </a>
      <a href={CONTACT.instagram} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-brand transition-colors" aria-label="Instagram">
        <InstagramIcon size={20} />
      </a>
      <a href={CONTACT.facebook} target="_blank" rel="noopener noreferrer" class="text-muted hover:text-brand transition-colors" aria-label="Facebook">
        <FacebookIcon size={20} />
      </a>
    </div>
    <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="bg-brand text-dark font-display font-semibold text-sm px-6 py-3 rounded-full hover:scale-105 transition-transform shadow-lg shadow-brand/20 w-full text-center">
      Cotizá ahora
    </a>
  </div>
</nav>

<script>
  import '../scripts/header';
</script>
