---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
---

<header class="fixed top-0 left-0 w-full z-50 backdrop-blur-xl">
  <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between gap-4">
    <!-- Logo -->
    <a href="/" class="flex min-w-0 items-center gap-3">
      <Image src={logo} alt="SP Soluciones Textiles" width={40} height={40} />
      <span class="truncate text-white font-semibold text-base sm:text-lg tracking-tight">SP Soluciones Textiles</span>
    </a>

    <!-- Nav -->
    <nav class="hidden md:flex items-center gap-8">
      <a href="/" class="text-gray-300 hover:text-white transition-colors text-sm font-medium">Inicio</a>
      <a href="#servicios" class="text-gray-300 hover:text-white transition-colors text-sm font-medium">Servicios</a>
      <a href="#catalogo" class="text-gray-300 hover:text-white transition-colors text-sm font-medium">Cat&aacute;logo</a>
      <a href="#nosotros" class="text-gray-300 hover:text-white transition-colors text-sm font-medium">Nosotros</a>
      <a href="#contacto" class="bg-[#f28705] text-black font-bold text-sm px-5 py-2.5 rounded-full hover:scale-105 transition-transform shadow-lg">
        Contacto
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-white/10 text-white transition-colors hover:border-[#f28705]/60 [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Abrir men&uacute;</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 17h16"></path>
        </svg>
      </summary>
      <nav class="absolute right-0 mt-3 flex w-52 flex-col gap-1 rounded-2xl border border-white/10 bg-dark/95 p-2 shadow-2xl backdrop-blur-xl">
        <a href="/" class="rounded-xl px-4 py-3 text-sm font-medium text-gray-200 hover:bg-white/5 hover:text-white">Inicio</a>
        <a href="#servicios" class="rounded-xl px-4 py-3 text-sm font-medium text-gray-200 hover:bg-white/5 hover:text-white">Servicios</a>
        <a href="#catalogo" class="rounded-xl px-4 py-3 text-sm font-medium text-gray-200 hover:bg-white/5 hover:text-white">Cat&aacute;logo</a>
        <a href="#nosotros" class="rounded-xl px-4 py-3 text-sm font-medium text-gray-200 hover:bg-white/5 hover:text-white">Nosotros</a>
        <a href="#contacto" class="rounded-xl bg-[#f28705] px-4 py-3 text-sm font-bold text-black">Contacto</a>
      </nav>
    </details>
  </div>
</header>
