---
import bgmain from '../../assets/bgmainblur.webp';
import videoMp4 from '../../assets/video.mp4';
import { BASE_PATH } from '../../config';
import WhatsAppButton from '../WhatsAppButton.astro';
---

<section
  class="hero-section relative min-h-[100svh] pt-16 md:pt-20 flex flex-col items-center text-center px-5 sm:px-6 overflow-hidden bg-dark"
>
  <div
    class="hidden md:block absolute inset-0 scale-105 bg-cover bg-center bg-no-repeat"
    style={`background-image: url('${bgmain.src}');`}
    aria-hidden="true"
  ></div>
  <video
    class="md:hidden absolute inset-0 w-full h-full object-cover"
    autoplay muted loop playsinline
    aria-hidden="true"
  >
    <source src={videoMp4} type="video/mp4" />
  </video>
  <div
    class="absolute inset-0 opacity-[0.06]"
    style={`background-image: url('${BASE_PATH}weave-pattern.svg'); background-repeat: repeat;`}
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 z-[1]"
    style="background: linear-gradient(to bottom, rgb(10,10,10) 10%, transparent 50%, rgb(10,10,10) 90%);"
    aria-hidden="true"
  ></div>

  <!-- Title - top -->
  <div class="relative z-10 pt-8 md:pt-16">
    <h1 class="font-display text-4xl sm:text-5xl md:text-8xl font-bold tracking-tight leading-tight text-balance">
      <span class="text-shimmer text-shimmer-stagger">Personalizamos</span><br />
      <span class="text-shimmer text-shimmer-stagger">cada detalle</span><br />
      <span class="text-shimmer text-shimmer-stagger">de tu marca.</span>
    </h1>
  </div>

  <!-- Center: empty - video visible -->
  <div class="flex-1"></div>

  <!-- Subtitle + CTA - bottom -->
  <div class="relative z-10 flex flex-col items-center pb-8 md:pb-16">
    <p class="text-muted text-base md:text-lg max-w-xl text-balance">
      Brindamos soluciones textiles para todo tipo de negocios, minorista o al por mayor.<br />
      Bordados y estampados DTF con calidad premium.
    </p>
    <WhatsAppButton class="mt-6 sm:mt-8 active:scale-95" />
  </div>
</section>
