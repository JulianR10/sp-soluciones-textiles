---
const stats = [
  { count: 500, suffix: '+', label: 'Prendas entregadas', icon: 'bag' },
  { count: 100, suffix: '+', label: 'Marcas confían en nosotros', icon: 'star' },
  { count: 5, suffix: '+', label: 'Años de experiencia', icon: 'calendar' },
  { count: 48, suffix: 'h', label: 'Entrega promedio', icon: 'clock' },
];
---

<section id="estadisticas"
  class="relative py-24 px-5 sm:px-6 reveal bg-brand/5"
  style={`--stitch-url: url('${import.meta.env.BASE_URL}stitch-pattern.svg');`}
>
  <div class="stitch-strip stitch-strip--top" aria-hidden="true"></div>
  <div class="stitch-strip stitch-strip--bottom" aria-hidden="true"></div>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 stagger-group">

      {stats.map((s) => (
      <div class="stagger-item">
        <div class="bg-surface border-2 border-dashed border-brand/25 rounded-[3px] p-5 w-full text-center transition-all duration-300 hover:border-brand/40 hover:-translate-y-1 hover:shadow-[0_8px_30px_rgba(255,144,37,0.15)]">
          <svg class="w-7 h-7 text-brand/40 mb-3 mx-auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            {s.icon === 'bag' && <>
              <path d="M6 4h4l1 2h2l1-2h4l2 4v12H4V8z" />
              <path d="M10 4c0 1.1.9 2 2 2s2-.9 2-2" />
            </>}
            {s.icon === 'star' && <>
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </>}
            {s.icon === 'calendar' && <>
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </>}
            {s.icon === 'clock' && <>
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </>}
          </svg>
          <p class="font-display text-3xl md:text-4xl font-bold text-brand mb-1"><span data-count={s.count}>0</span>{s.suffix}</p>
          <p class="text-muted text-sm">{s.label}</p>
        </div>
      </div>
      ))}

    </div>
  </div>
</section>

<script>
  import '../../scripts/stats-counter';
</script>
