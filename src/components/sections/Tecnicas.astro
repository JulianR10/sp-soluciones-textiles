---
import { Image } from 'astro:assets';
import boton from '../../assets/boton.webp';
import { WHATSAPP_URL } from '../../config';
---

<section id="tecnicas" class="group relative w-[calc(100%-3rem)] md:w-[80vw] mx-auto my-24 py-24 px-5 sm:px-6 reveal rounded-3xl overflow-hidden bg-dark" style={`background-image: url('${import.meta.env.BASE_URL}weave-pattern.svg'); background-repeat: repeat;`}>

  <div class="absolute inset-[2px] rounded-[22px] pointer-events-none z-10 border border-brand/50 transition-all duration-500 group-hover:border-brand/70 group-hover:shadow-[inset_0_0_30px_rgba(255,144,37,0.08)]"></div>

  <div class="absolute inset-[7px] rounded-[17px] pointer-events-none z-10 border border-dashed border-brand/40 transition-all duration-500 group-hover:border-brand/50"></div>

  <div class="relative z-20 max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
    
    <div class="text-center lg:text-left">
      <span class="text-brand text-sm font-display font-semibold uppercase tracking-widest mb-3 inline-block">
        Técnicas que utilizamos
      </span>
      <h2 class="font-display text-3xl md:text-5xl font-bold text-light leading-tight mb-6 text-balance">
        ¿Con qué <br class="hidden lg:block">trabajamos?
      </h2>
      <div class="w-12 h-px bg-brand mb-6 lg:mx-0 mx-auto"></div>
      <p class="text-muted text-sm md:text-base leading-relaxed text-balance">
        Utilizamos dos técnicas de alta calidad para garantizar resultados profesionales, duraderos y con una terminación impecable.
      </p>
      <p class="text-muted text-sm md:text-base leading-relaxed mt-4 text-balance">
        Elegí la que mejor se adapte a tu proyecto o combiná ambas para un resultado único.
      </p>
    </div>

    <div class="flex flex-col gap-14 stagger-group">
      
      <div class="stagger-item relative">
        <div class="flex items-center gap-3 mb-2">
          <Image src={boton} alt="" width={24} height={24} class="flex-shrink-0" />
          <h3 class="font-display text-xl md:text-2xl font-bold text-light">
            Bordados
          </h3>
        </div>
        <p class="text-muted text-sm md:text-base leading-relaxed text-balance">
          Puntadas de alta precisión con relieve premium. Ideal para uniformes corporativos, marcas y prendas que buscan una terminación elegante y duradera.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="text-xs bg-brand/20 text-brand px-2 py-1 rounded-full">Alta durabilidad</span>
          <span class="text-xs bg-brand/20 text-brand px-2 py-1 rounded-full">Efecto 3D</span>
        </div>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-1.5 text-brand font-display font-semibold text-sm border border-brand/50 px-4 py-2 rounded-full hover:bg-brand/10 hover:border-brand/70 transition-all duration-200">
          Cotizá este servicio <span class="inline-block transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </a>
      </div>

      <div class="stagger-item relative">
        <div class="flex items-center gap-3 mb-2">
          <Image src={boton} alt="" width={24} height={24} class="flex-shrink-0" />
          <h3 class="font-display text-xl md:text-2xl font-bold text-light">
            Estampado DTF
          </h3>
        </div>
        <p class="text-muted text-sm md:text-base leading-relaxed text-balance">
          Impresión digital de alta definición con colores vibrantes y excelente durabilidad sobre distintos tipos de telas.
        </p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="text-xs bg-brand/20 text-brand px-2 py-1 rounded-full">Alta resolución</span>
          <span class="text-xs bg-brand/20 text-brand px-2 py-1 rounded-full">Funciona en oscuras</span>
        </div>
        <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer"
          class="mt-5 inline-flex items-center gap-1.5 text-brand font-display font-semibold text-sm border border-brand/50 px-4 py-2 rounded-full hover:bg-brand/10 hover:border-brand/70 transition-all duration-200">
          Cotizá este servicio <span class="inline-block transition-transform duration-200 group-hover:translate-x-0.5">→</span>
        </a>
      </div>

    </div>
  </div>
</section>
