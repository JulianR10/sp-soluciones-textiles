---
import buzosImg from '../../assets/buzos.webp';
import camisTrabajoLux from '../../assets/camis-trabajo-lux.webp';
import camisetaConex from '../../assets/camiseta-conex.webp';
import campera from '../../assets/campera.webp';
import cuelloPolo3 from '../../assets/cuello-polo3.webp';
import gorras1 from '../../assets/gorras1.webp';
import gorritoInvierno from '../../assets/gorritos2.webp';
import pantalones1 from '../../assets/pantalones1.webp';

const products = [
  { name: 'Camisetas', image: camisetaConex, lines: ['Algodón peinado 180 g.', 'El clásico que nunca falla.'] },
  { name: 'Buzos', image: buzosImg, lines: ['Frisa cepillada 320 g.', 'Abrigo con actitud.'] },
  { name: 'Camperas', image: campera, lines: ['Estilo que abriga.', 'Listas para personalizar.'] },
  { name: 'Camisas', image: camisTrabajoLux, lines: ['Elegancia que resiste.', 'Tu mejor versión.'] },
  { name: 'Cuello Polo', image: cuelloPolo3, lines: ['Sport o formal.', 'El equilibrio perfecto.'] },
  { name: 'Pantalones', image: pantalones1, lines: ['Gabardina de algodón.', 'Movimiento libre.'] },
  { name: 'Gorras', image: gorras1, lines: ['Perfil curvo o recto.', 'Tu sello, bien visible.'] },
  { name: 'Gorro Invierno', image: gorritoInvierno, lines: ['Polar térmico.', 'Calidez que se ve.'] },
];

const tallIdx = new Set([0, 3]);
const wideIdx = new Set([6, 7]);
const mobileSoftIdx = new Set([4, 5, 6, 7]);

function cardSize(i: number): string {
  if (tallIdx.has(i)) return 'min-h-[380px] sm:min-h-[440px] lg:min-h-[520px]';
  if (wideIdx.has(i)) return 'min-h-[240px] sm:min-h-[280px] lg:min-h-[300px]';
  return 'min-h-[260px] sm:min-h-[300px] lg:min-h-[250px]';
}

const gridPos = [
  'lg:row-span-2 lg:col-start-1 lg:row-start-1',
  'lg:col-start-2 lg:row-start-1',
  'lg:col-start-3 lg:row-start-1',
  'lg:row-span-2 lg:col-start-4 lg:row-start-1',
  'lg:col-start-2 lg:row-start-2',
  'lg:col-start-3 lg:row-start-2',
  'lg:col-span-2 lg:row-start-3',
  'lg:col-span-2 lg:col-start-3 lg:row-start-3',
];
---

<section id="servicios" class="relative py-24 px-5 sm:px-6 bg-dark overflow-hidden">
  <div class="aurora-container" aria-hidden="true">
    <div class="aurora-blob aurora-blob--1"></div>
    <div class="aurora-blob aurora-blob--2"></div>
    <div class="aurora-blob aurora-blob--3"></div>
  </div>
  <div class="max-w-7xl mx-auto">

    <div class="flex flex-col items-center text-center mb-16 md:mb-20">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-light leading-tight text-balance">
        Nuestra <span class="text-brand">gama de productos</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-5">
      {products.map((product, i) => (
        <article
          class={`card-glass group rounded-2xl overflow-hidden ${gridPos[i]} ${cardSize(i)}`}
        >
          <img
            src={product.image.src}
            alt={product.name}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class={`card-overlay ${wideIdx.has(i) ? 'card-overlay--wide' : ''} ${mobileSoftIdx.has(i) ? 'card-overlay--mobile-soft' : ''}`}></div>
          <div class="absolute bottom-0 left-5 right-5 md:left-6 md:right-6 h-[1.5px] bg-gradient-to-r from-transparent via-brand/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
          <div class="relative z-10 flex flex-col justify-end h-full p-5 md:p-6">
            <h3 class="font-display text-xl md:text-2xl font-bold text-light">{product.name}</h3>
            <p class="text-muted text-sm mt-1.5 leading-relaxed">{product.lines[0]}<br/>{product.lines[1]}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
