---
import buzosImg from '../../assets/buzos.webp';
import camisTrabajoLux from '../../assets/camis-trabajo-lux.webp';
import camisetaConex from '../../assets/camiseta-conex.webp';
import campera from '../../assets/campera.webp';
import cuelloPolo3 from '../../assets/cuello-polo3.webp';
import gorras1 from '../../assets/gorras1.webp';
import gorritoInvierno from '../../assets/gorritos2.webp';
import pantalones1 from '../../assets/pantalones1.webp';

const products = [
  {
    name: 'Camisetas',
    image: camisetaConex,
    lines: ['Algodón peinado 180 g.', 'El clásico que nunca falla.'],
    drop: 48,
  },
  { name: 'Buzos', image: buzosImg, lines: ['Frisa cepillada 320 g.', 'Abrigo con actitud.'], drop: 32 },
  { name: 'Camperas', image: campera, lines: ['Estilo que abriga.', 'Listas para personalizar.'], drop: 56 },
  { name: 'Camisas', image: camisTrabajoLux, lines: ['Elegancia que resiste.', 'Tu mejor versión.'], drop: 28 },
  { name: 'Cuello Polo', image: cuelloPolo3, lines: ['Sport o formal.', 'El equilibrio perfecto.'], drop: 48 },
  { name: 'Pantalones', image: pantalones1, lines: ['Gabardina de algodón.', 'Movimiento libre.'], drop: 40 },
  { name: 'Gorras', image: gorras1, lines: ['Perfil curvo o recto.', 'Tu sello, bien visible.'], drop: 32 },
  { name: 'Gorro Invierno', image: gorritoInvierno, lines: ['Polar térmico.', 'Calidez que se ve.'], drop: 56 },
];
---

<section id="servicios" class="relative py-24 px-5 sm:px-6 overflow-hidden">
  <div class="max-w-7xl mx-auto">

    <div class="flex flex-col items-center text-center mb-16 md:mb-20">
      <h2 class="font-display text-3xl md:text-5xl font-bold text-light leading-tight text-balance">
        Nuestra <span class="text-brand">gama de productos</span>
      </h2>
      <p class="text-muted text-sm md:text-base mt-4 max-w-lg text-balance">Prendas de calidad premium listas para personalizar con tu marca</p>
    </div>

    <div class="relative">
      <button id="product-prev" class="product-arrow product-arrow--prev" aria-label="Anterior">
        <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5l-5 5 5 5"/></svg>
      </button>
      <button id="product-next" class="product-arrow product-arrow--next" aria-label="Siguiente">
        <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M8 5l5 5-5 5"/></svg>
      </button>

      <div id="product-track" class="product-carousel flex overflow-x-auto snap-x snap-mandatory gap-4 pb-2 lg:grid lg:grid-cols-4 lg:gap-x-6 lg:gap-y-20 lg:snap-none lg:overflow-visible">
        {products.map((product) => (
          <article class="hang-card flex flex-col items-center group product-snap min-w-[80vw] sm:min-w-[65vw] md:min-w-[42vw] lg:min-w-0 flex-shrink-0">
            <div class="hang-pin"></div>
            <div class="hang-thread" style={`height: ${product.drop}px;`}></div>
            <div class="hang-body bg-surface rounded-2xl overflow-hidden border border-brand/20 w-full max-w-[300px] sm:max-w-[340px] lg:max-w-none mx-auto">
              <div class="aspect-square sm:aspect-[3/4] relative overflow-hidden">
                {product.image ? (
                  <img
                    src={product.image.src}
                    alt={product.name}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center bg-warp-weft-subtle">
                    <span class="font-display text-8xl font-bold text-brand/10 select-none">
                      {product.name.charAt(0)}
                    </span>
                  </div>
                )}
                <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-surface to-transparent pointer-events-none"></div>
              </div>
              <div class="relative px-5 pb-6 -mt-6">
                <h3 class="font-display text-xl md:text-2xl font-bold text-light">{product.name}</h3>
                <p class="text-muted text-sm mt-2 leading-relaxed text-balance">{product.lines[0]}<br/>{product.lines[1]}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  import '../../scripts/product-carousel';
</script>
