---
import '../styles/global.css';

import fraunces700 from '@fontsource/fraunces/files/fraunces-latin-700-normal.woff2?url';
import appleTouch from '../assets/apple-touch-icon.png';
import bgmain from '../assets/bgmainblur.webp';
import bgmain1024 from '../assets/bgmainblur-1024.webp';
import favicon from '../assets/favicon.png';
import logo from '../assets/logo.png';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { BASE_PATH, CONTACT } from '../config';

const { title } = Astro.props;

const siteUrl = import.meta.env.SITE;
const canonical = new URL(import.meta.env.BASE_URL, siteUrl).toString();
const ogImage = new URL(logo.src, siteUrl).toString();
const fullTitle = `${title} | SP Soluciones Textiles`;
const description =
  'SP Soluciones Textiles: venta de prendas lisas y personalizadas con bordado o estampado DTF. Soluciones textiles para negocios, gimnasios, empresas y emprendimientos.';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${canonical}#org`,
  name: 'SP Soluciones Textiles',
  url: canonical,
  logo: ogImage,
  image: ogImage,
  description,
  sameAs: [CONTACT.instagram, CONTACT.facebook],
  makesOffer: [
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Venta de prendas lisas',
        description: 'Venta de prendas para personalizar por tu cuenta.',
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Venta de prendas personalizadas',
        description: 'Prendas personalizadas con bordado o estampado DTF.',
      },
    },
    {
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: 'Servicio de bordado',
        description: 'Servicio de bordado profesional sobre prendas.',
      },
    },
  ],
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: `+${CONTACT.whatsapp}`,
    contactType: 'sales',
  },
};
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FF9025" />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <link rel="preload" as="font" href={fraunces700} type="font/woff2" crossorigin />
    <link
      rel="preload"
      as="image"
      href={bgmain.src}
      imagesrcset={`${bgmain1024.src} 1024w, ${bgmain.src} 1920w`}
      imagesizes="100vw"
      media="(min-width: 768px)"
      fetchpriority="high"
    />
    <link rel="icon" type="image/svg+xml" href={`${BASE_PATH}favicon.svg`} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <link rel="apple-touch-icon" href={appleTouch.src} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SP Soluciones Textiles" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>
    <noscript>
      <style>
        .reveal,
        .stagger-item {
          opacity: 1 !important;
          transform: none !important;
          transition: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="bg-dark text-light font-sans flex flex-col min-h-screen">
    <Header />
    <main class="relative flex-1 bg-dark">
      <slot />
    </main>
    <Footer />
    <script>
  import '../scripts/scroll-reveal';
</script>
  </body>
</html>