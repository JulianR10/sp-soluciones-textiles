---
import '../styles/global.css';

const { title } = Astro.props;

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content="SP Soluciones Textiles - Bordados y estampados DTF" />
    <title>{title} | SP Soluciones Textiles</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Fraunces:opsz,wght,SOFT@9..144,400..900,0..100&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
  </head>
  <body class="bg-dark text-light font-sans flex flex-col min-h-screen">
    <Header />
    <main class="relative flex-1 bg-dark">
      <slot />
    </main>
    <Footer />
    <script>
  import '../scripts/scroll-reveal';
</script>
  </body>
</html>